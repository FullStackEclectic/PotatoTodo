# Copy this file to android/key.properties and replace every value before a
# release build. Keep android/key.properties out of version control.
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_KEY_PASSWORD
keyAlias=REPLACE_WITH_KEY_ALIAS
storeFile=REPLACE_WITH_ABSOLUTE_OR_PROJECT_RELATIVE_KEYSTORE_PATH
